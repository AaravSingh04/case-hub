# ==============================================================================
# CASE HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Case Hub (Discover. Share. Compete.)
# ==============================================================================

# Application Base URL (used for constructing internal email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Admin Allowlist (Comma-separated emails authorized for administrative access)
ADMIN_EMAILS=admin@casehub.internal,administrator@casehub.internal

# Administrator Notification Recipient(s) (Receives alerts on student uploads, discoveries, etc.)
ADMIN_NOTIFICATION_EMAILS=admin@casehub.internal
ADMIN_NOTIFICATION_EMAIL=admin@casehub.internal

# Google Gemini API Key (Enables Google Search Grounding for Automated Competition Discovery from Unstop)
# If omitted, discovery seamlessly utilizes the verified Unstop MBA competition source pool
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Transactional Email Service Options (Required to deliver OTP codes to real inboxes)
# ------------------------------------------------------------------------------
# Option A: Resend (https://resend.com)
# If using Resend free tier without a custom domain, use "Case Hub <onboarding@resend.dev>"
RESEND_API_KEY=
EMAIL_FROM="Case Hub <onboarding@resend.dev>"

# Option B: Standard SMTP / Gmail App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password

# ------------------------------------------------------------------------------
# Database & Cron Security
# ------------------------------------------------------------------------------
# Supabase Production Database & Auth Integration (Optional; local /tmp storage used by default)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automation / Scheduled Job Secret (Secures /api/cron/closing-soon and /api/cron/discovery)
CRON_SECRET=case_hub_cron_secret_key
