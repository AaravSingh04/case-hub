# ==============================================================================
# CASE HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Case Hub (Discover. Share. Compete.)
# Institution: HSB Jaipur
# ==============================================================================

# Application Base URL (used for constructing internal email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrator Notification Recipient (Receives instant alert on every student competition upload)
ADMIN_NOTIFICATION_EMAIL=admin@casehub.internal

# Transactional Email Service (Resend or equivalent)
# If omitted, notifications are logged to the persistent notification outbox and console
RESEND_API_KEY=
EMAIL_FROM="Case Hub <notifications@casehub.internal>"

# Supabase Production Database & Auth Integration (Optional for local persistent mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automation / Scheduled Job Secret (Secures /api/cron/closing-soon)
CRON_SECRET=case_hub_cron_secret_key
